{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://genshin-theater-assistant.local/schema/evaluation.schema.json",
  "title": "Evaluation（独立评测，禁止用模型自身输出当真值）",
  "type": "object",
  "required": ["id", "kind", "labels", "created_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^eval-[A-Za-z0-9_-]+$" },
    "kind": { "enum": ["recognition", "knowledge", "strategy", "end_to_end"] },
    "split": { "enum": ["train", "validation", "holdout", "historical"], "default": "holdout" },
    "season": { "type": ["integer", "null"] },
    "game_version": { "type": ["string", "null"] },
    "labels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["case_id", "truth_source", "truth"],
        "properties": {
          "case_id": { "type": "string" },
          "frame_ref": { "type": ["string", "null"] },
          "video_id": { "type": ["string", "null"] },
          "creator_id": { "type": ["string", "null"] },
          "timestamp": { "type": ["string", "null"] },
          "truth_source": { "enum": ["human", "subtitle_and_chapter", "game_ui", "manual_import"], "description": "禁止 production_ocr_prediction" },
          "truth": { "type": "object", "additionalProperties": true },
          "acceptable_set": { "type": "array", "items": { "type": "object" }, "description": "多个可行策略，用于 Decision Regret" },
          "unacceptable": { "type": "array", "items": { "type": "object" } }
        }
      }
    },
    "isolation": {
      "type": "object",
      "properties": {
        "group_by": { "enum": ["video", "creator", "season"], "description": "训练/测试按组隔离，不能随机拆帧" },
        "excluded_from_training": { "type": "boolean" }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "coverage": { "type": ["number", "null"], "description": "真值覆盖率；无真值时准确率必须 N/A" },
        "accuracy": { "type": ["number", "null"] },
        "macro_f1": { "type": ["number", "null"] },
        "recall_at_k": { "type": ["number", "null"] },
        "decision_regret": { "type": ["number", "null"] },
        "abstention_precision": { "type": ["number", "null"] }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "algorithm_version": { "type": ["string", "null"] },
    "knowledge_version": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
