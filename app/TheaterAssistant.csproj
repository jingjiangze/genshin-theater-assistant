<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>

    <AssemblyName>TheaterAssistant</AssemblyName>
    <RootNamespace>TheaterAssistant</RootNamespace>
    <Product>幻想真境剧诗 · 助手</Product>
    <Version>0.49.0</Version>

    <!-- 单文件自包含：把 exe + 运行时 + 数据 + 模型打成同一个文件 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
    <DebugType>none</DebugType>

    <!-- DPI 感知：不声明的话 ClientToScreen 给逻辑坐标、CopyFromScreen 按物理像素取，缩放屏上抓屏整体错位 -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Apache-2.0；PP-OCRv5/v6 ONNX 管线（SkiaSharp + OnnxRuntime），跨平台，AOT 友好 -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />

    <!--
      DirectML 加速：**当前不可用，已在 CI 实测确认**（2026-11-08）。
        上游事实：Microsoft.ML.OnnxRuntime.DirectML 停更在 1.24.4，
        RapidOcrNet 4.2.0 依赖 Microsoft.ML.OnnxRuntime 1.29.0
        → CI 报 NU1102「Unable to find package ...DirectML with version (>= 1.29.0)，Nearest 1.24.4」。
        不能降级 OnnxRuntime 去迁就 DirectML（会牺牲 RapidOcr 的新特性与取消支持）。

      代码侧已就绪：OcrService.BuildSessionOptions 用反射探测 AppendExecutionProvider_DML，
        当前实测 EP=CPU(DirectML 不可用: EntryPointNotFoundException) —— 即"方法在托管层存在、
        原生层无该 EP"，被 catch 后正确回退 CPU，不崩、不影响可用性。

      一旦上游发布匹配版本的 DirectML 包，只需：
        dotnet publish -p:DirectMLVersion=1.29.0
      即可让同一份代码自动切到 DirectML(gpu0)，无需改代码。
    -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="$(DirectMLVersion)"
                      Condition="'$(DirectMLVersion)' != ''" />
    <!-- 启用 DirectML 时屏蔽传递引入的纯 CPU 原生库，避免两份 onnxruntime.dll 冲突 -->
    <PackageReference Update="Microsoft.ML.OnnxRuntime" ExcludeAssets="runtime"
                      Condition="'$(DirectMLVersion)' != ''" />
    <!-- 内嵌 B站官方播放器 / BWIKI 页面；缺失运行时自动退回系统浏览器 -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <!-- 赛季数据 / 角色元素表 / 模板清单：随 exe 一起打包 -->
    <Content Include="data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="templates\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <!-- OCR 模型：作为嵌入资源打进单文件 exe，运行时解压到 %LOCALAPPDATA%\TheaterAssistant\models -->
    <EmbeddedResource Include="models\**\*.onnx" />
    <EmbeddedResource Include="models\**\*.txt" />
  </ItemGroup>

</Project>
