<Project Sdk="Microsoft.NET.Sdk">

  <!-- 云端/Linux OCR 探针：只用 RapidOcrNet + SkiaSharp（不依赖 System.Drawing / WinForms），
       用于在云端 box 上验证"针对云端环境的模型"：v5-mobile vs v6-small、CPU 线程、速度与一致率。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>OcrProbe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
  </ItemGroup>

</Project>
