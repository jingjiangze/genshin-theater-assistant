<Application x:Class="TheaterAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
      <!--
        Fluent 主题与控件模板（WPF-UI 4.3.0）——BetterGI 的观感主要来自这一层：
        Dark 主题 + 全套控件模板（Button/ComboBox/ToggleSwitch/ScrollBar/TitleBar…）。
        我们只覆盖少量自有配色的资源，不去改它的主题键。
      -->
      <ResourceDictionary.MergedDictionaries>
        <ui:ThemesDictionary Theme="Dark"/>
        <ui:ControlsDictionary/>
      </ResourceDictionary.MergedDictionaries>

      <!-- 派蒙 + AI 助手风格配色（与 WinForms 版同源，但由 WPF 矢量渲染，无锯齿） -->
      <Color x:Key="CardTop">#F01E2434</Color>
      <Color x:Key="CardBottom">#F0121520</Color>
      <Color x:Key="AccentBlue">#7EB8E8</Color>
      <Color x:Key="TextPrimary">#E8F0FF</Color>
    <Color x:Key="TextBody">#D6DEEE</Color>
    <Color x:Key="TextDim">#848C9C</Color>

    <!-- Color 资源不能直接赋给 Fill/BorderBrush 等需要 Brush 的属性，
         必须显式包一层 SolidColorBrush（本次启动崩溃就是漏了这步）。 -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentBlue}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimary}"/>
    <SolidColorBrush x:Key="TextBodyBrush" Color="{StaticResource TextBody}"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="{StaticResource TextDim}"/>

    <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="{StaticResource CardTop}" Offset="0"/>
      <GradientStop Color="{StaticResource CardBottom}" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="CardShadow" BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000"/>

    <Style x:Key="HeadText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="BodyText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBodyBrush}"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="FootText" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextDimBrush}"/>
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
      <Setter Property="FontSize" Value="10"/>
    </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
