<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WPF 版（v0.60 起）。WinForms 版保留在 app/ 不动，等 WPF 版验收后再删。

    为什么换 WPF（2026-11 决定）：
      · WinForms 的圆角/半透明在 GDI+ 下有明显锯齿，观感"很差"（用户实测反馈）；
      · WPF 原生支持 AllowsTransparency + 矢量渲染 + 淡入动画，且 .NET 8 单文件打包成熟；
      · 不选 WinUI 3（胡桃工具箱的路线）：单文件 exe 需要 Windows App Runtime，
        对"下载即用"的分发形态不合适。

    关键：**纯逻辑全部复用 app/ 下的文件**（46 个文件 9009 行），这里只重写 UI 层。
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘用 WinForms 的 NotifyIcon（WPF 无内置托盘，这是社区标准做法）；
         WPF+WinForms 混用在 .NET 8 是官方支持组合。 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>TheaterAssistantWpf</AssemblyName>
    <RootNamespace>TheaterAssistant</RootNamespace>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/jingjiangze/genshin-theater-assistant</RepositoryUrl>
    <Version>0.60.0</Version>
    <AssemblyVersion>0.60.0.0</AssemblyVersion>
    <FileVersion>0.60.0.0</FileVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!-- 单文件发布（与 WinForms 版一致；体积不是瓶颈，压缩要开） -->
    <PublishSingleFile>false</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 关键：不加这行，Content（data/、templates/）不会打进单文件 exe，
         运行时 AppPaths.Data() 找不到 → 语料库显示 0 条（本轮实测踩到）。
         WinForms 版一直有这行，WPF 迁移时漏了。 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- 项目级 using：WPF 项目的隐式 using 集合与 WinForms 不同，System.IO/Text.Json 需显式声明 -->
    <!-- 根治二义性：UseWindowsForms 会隐式引入 System.Drawing / System.Windows.Forms 的 using，
         它们与 WPF 的同名类型（Point/Size/Color/Brush/Font/Application/MessageBox/MouseEventArgs…）
         全面二义。WPF 项目应以 WPF 类型为准 → 移除这两个隐式 using；
         需要 WinForms 的唯一地方（托盘 NotifyIcon）已显式写全名。 -->
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
    <Using Include="System.IO" />
    <Using Include="System.Text.Json" />
    <Using Include="System.Text.Json.Nodes" />
  </ItemGroup>

  <ItemGroup>
    <!-- 纯逻辑：直接复用 WinForms 版的实现（不含任何 UI 依赖） -->
    <!-- AppPaths 用 WPF 专用版（app-wpf/AppPaths.cs，支持嵌入资源解包），不再共享 app/ 的 -->
    <Compile Include="..\app\ActStabilizer.cs" Link="logic\ActStabilizer.cs" />
    <Compile Include="..\app\CharacterStrength.cs" Link="logic\CharacterStrength.cs" />
    <Compile Include="..\app\ChoiceDecider.cs" Link="logic\ChoiceDecider.cs" />
    <Compile Include="..\app\Cli.cs" Link="logic\Cli.cs" />
    <Compile Include="..\app\CuratedPicks.cs" Link="logic\CuratedPicks.cs" />
    <Compile Include="..\app\DecisionBridge.cs" Link="logic\DecisionBridge.cs" />
    <Compile Include="..\app\DecisionOrchestrator.cs" Link="logic\DecisionOrchestrator.cs" />
    <Compile Include="..\app\DecisionPolicy.cs" Link="logic\DecisionPolicy.cs" />
    <Compile Include="..\app\EnkaClient.cs" Link="logic\EnkaClient.cs" />
    <Compile Include="..\app\GlobalAllocator.cs" Link="logic\GlobalAllocator.cs" />
    <Compile Include="..\app\GuideIndex.cs" Link="logic\GuideIndex.cs" />
    <Compile Include="..\app\GuideNotes.cs" Link="logic\GuideNotes.cs" />
    <!-- 玩法档案：剧诗/深渊的识别区域与时间轴规则（data/modes.json 驱动） -->
    <Compile Include="..\app\GameMode.cs" Link="logic\GameMode.cs" />
    <!-- ◇模型层：data/llm.json 驱动的 OpenAI 兼容多端点顾问（本地 serve.py / 远端均可） -->
    <Compile Include="..\app\LlmAdvisor.cs" Link="logic\LlmAdvisor.cs" />
    <!-- 内嵌小模型：GGUF + 随包 llama-server 子进程，实测 147ms/答 -->
    <Compile Include="..\app\LocalBrain.cs" Link="logic\LocalBrain.cs" />
    <!-- 模板 ROI（BetterGI 式：识别对象自带搜索区域） -->
    <Compile Include="..\app\RoiMap.cs" Link="logic\RoiMap.cs" />
    <Compile Include="..\app\OcrTextPipeline.cs" Link="logic\OcrTextPipeline.cs" />
    <Compile Include="..\app\OcrTuning.cs" Link="logic\OcrTuning.cs" />
    <Compile Include="..\app\Playbook.cs" Link="logic\Playbook.cs" />
    <Compile Include="..\app\QualityGates.cs" Link="logic\QualityGates.cs" />
    <Compile Include="..\app\QuantData.cs" Link="logic\QuantData.cs" />
    <Compile Include="..\app\QuantScorer.cs" Link="logic\QuantScorer.cs" />
    <Compile Include="..\app\RosterMerge.cs" Link="logic\RosterMerge.cs" />
    <Compile Include="..\app\RosterResolver.cs" Link="logic\RosterResolver.cs" />
    <Compile Include="..\app\Routine.cs" Link="logic\Routine.cs" />
    <Compile Include="..\app\ScreenMetrics.cs" Link="logic\ScreenMetrics.cs" />
    <Compile Include="..\app\SeasonRegistry.cs" Link="logic\SeasonRegistry.cs" />
    <Compile Include="..\app\Speech.cs" Link="logic\Speech.cs" />
    <Compile Include="..\app\TeamSolver.cs" Link="logic\TeamSolver.cs" />
    <Compile Include="..\app\Advice.cs" Link="logic\Advice.cs" />
    <!-- 主循环输入侧：抓屏(GameWindow/ScreenCapture) + OCR + 模板匹配 + 幕内逻辑 -->
    <Compile Include="..\app\Recognition.cs" Link="logic\Recognition.cs" />
    <Compile Include="..\app\TemplateEntry.cs" Link="logic\TemplateEntry.cs" />
    <Compile Include="..\app\OcrService.cs" Link="logic\OcrService.cs" />
    <Compile Include="..\app\TemplateFactory.cs" Link="logic\TemplateFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- llama.cpp 官方 llama-server（随包，应用自己拉起；实测 59+64 token = 147ms） -->
    <Content Include="../native/llama-server/*">
      <Link>llama-server/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <!-- 模型走 EmbeddedResource（编译期就存在，glob 没问题） -->
    <EmbeddedResource Include="models\**\*.onnx" Condition="Exists('models')" />
    <EmbeddedResource Include="models\**\*.txt" Condition="Exists('models')" />
    <!-- 内嵌小模型 GGUF（Q8_0 26MB）：打进单文件 exe，首启解压到 %LOCALAPPDATA%\TheaterAssistant\models\llm
         LogicalName 必须全点号（%(RecursiveDir) 原生带反斜杠，会让 AppPaths 的两种探测都落空——CI 实测踩过） -->
    <EmbeddedResource Include="models\**\*.gguf" Condition="Exists('models')">
      <LogicalName>TheaterAssistant.res.models.$([System.String]::Copy('%(RecursiveDir)').Replace('\','.'))%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <!-- 与 WinForms 版一致：RapidOcrNet 提供 PP-OCR 推理 -->
    <PackageReference Include="RapidOcrNet" Version="4.2.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <!-- Fluent 控件与主题：BetterGI 的观感九成来自它（FluentWindow/TitleBar/ToggleSwitch/CardControl）。
         4.3.0 支持 net8.0-windows，单 TFM 引入。 -->
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!-- 内嵌推理：llama.cpp 的 C# 绑定（GGUF，CPU 后端）。实测 26M Q8 生成 63 token ≈ 50ms -->
    <!-- OpenCV：用于 OCR 预处理（BetterGI 的 D3–D5）。
         注意 D3(竖排旋转)/D4(透视裁剪) RapidOcrNet 内部已实现，这里只为 D5(白字掩膜) 及后续增强引入。 -->
    <PackageReference Include="OpenCvSharp4" Version="4.13.0.20261107" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20261107" />
    <!-- BitmapConverter（Bitmap ↔ Mat）在 Extensions 包，不在 core -->
    <PackageReference Include="OpenCvSharp4.Extensions" Version="4.13.0.20261107" />
  </ItemGroup>

  <!--
    随包资源（data/、templates/）用**静态 EmbeddedResource**。
    四次尝试的经验（全部实测过）：
      ① 静态 Content glob → 打进的是编译期内容，且单文件 bundle 里取不到；
      ② ContentWithTargetPath 动态 → NETSDK1152（33 个文件同路径冲突）；
      ③ 动态 Content + CopyToPublishDirectory → dist-wpf/data 文件数始终 0；
      ④ Target 里加 EmbeddedResource 挂 PrepareForPublish → **太晚**，编译早已完成，资源没进 dll。
    静态 EmbeddedResource 的 glob 在**编译开始时**求值，而 CI 是在 `dotnet publish` 之前
    就把 data 复制到 app-wpf/ 的，所以能扫到；AppPaths 首次读取时解包到
    %LOCALAPPDATA%\TheaterAssistant\data。
  -->
  <ItemGroup Condition="Exists('data')">
    <EmbeddedResource Include="data\**\*">
      <LogicalName>TheaterAssistant.res.data.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="Exists('templates')">
    <EmbeddedResource Include="templates\**\*">
      <LogicalName>TheaterAssistant.res.templates.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
