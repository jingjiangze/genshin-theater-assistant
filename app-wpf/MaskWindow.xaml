<Window x:Class="TheaterAssistant.MaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TheaterAssistant"
        Title="剧诗助手 · 遮罩"
        Width="1280" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

  <!--
    遮罩窗口（结构照抄 BetterGI 的 MaskWindow，视觉按"文字更醒目 + 更不占视野"重做）：
      · 整窗透明、无边框、置顶、不抢焦点、默认点击穿透；
      · 左下角一块紧凑卡片：默认只显示「现在做」+ 状态；日志按 Ctrl+Alt+M 展开；
      · 一层识别框（帧像素 → 窗口比例换算）；
      · 位置/尺寸由 MaskWindowHost 按游戏客户区跟随。

    为什么默认收起日志：玩家在打，不是在看日志。占视野的是"解释"，不是"指令"。
  -->
  <Grid x:Name="Root" Background="Transparent">

    <local:MaskDrawingLayer x:Name="DrawLayer"/>

    <Border x:Name="Panel"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="14,0,0,92"
            Width="404"
            CornerRadius="9"
            BorderThickness="1"
            BorderBrush="#40FFFFFF">
      <Border.Background>
        <SolidColorBrush Color="#E6141720"/>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.5" Color="#000000"/>
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题行：玩法名 + 状态胶囊 + 折叠指示 -->
        <Grid Grid.Row="0" Margin="12,8,12,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="3" Height="13" CornerRadius="2"
                  Background="#FF4C8DFF" Margin="0,0,8,0" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="1" x:Name="TitleText" Text="剧诗助手"
                     FontFamily="Microsoft YaHei UI" FontSize="12.5" FontWeight="SemiBold"
                     Foreground="#FFF2F6FF" VerticalAlignment="Center"
                     TextTrimming="CharacterEllipsis"/>

          <Border Grid.Column="2" x:Name="StatusChip" CornerRadius="7" Padding="7,1.5"
                  Background="#33FFFFFF" VerticalAlignment="Center" MaxWidth="200" Margin="8,0,0,0">
            <TextBlock x:Name="StatusText" Text="初始化…"
                       FontFamily="Microsoft YaHei UI" FontSize="10.5"
                       TextTrimming="CharacterEllipsis"
                       Foreground="#FFBFD4F0"/>
          </Border>

          <TextBlock Grid.Column="3" x:Name="Chevron" Text="▸" Margin="7,0,0,0"
                     FontSize="10" Foreground="#FF8C96A8" VerticalAlignment="Center"/>
        </Grid>

        <!-- 「现在做」：整块界面里唯一必须一眼看到的东西 -->
        <Grid Grid.Row="1" x:Name="AdviceRow" Margin="12,7,12,9" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0" Grid.Row="0" x:Name="AdviceMark" Text="▶" Margin="0,2,7,0" FontSize="11"
                     Foreground="#FF5BD48E" VerticalAlignment="Top"/>
          <TextBlock Grid.Column="1" Grid.Row="0" x:Name="AdviceText" Text=""
                     FontFamily="Microsoft YaHei UI" FontSize="14.5" FontWeight="SemiBold"
                     Foreground="#FFFFFFFF" TextWrapping="Wrap"
                     MaxHeight="42" TextTrimming="CharacterEllipsis"
                     LineHeight="20" LineStackingStrategy="BlockLineHeight"/>
          <!-- 战斗中的指导：当前幕的手法步骤（第二条，小一号，不抢「现在做」） -->
          <TextBlock Grid.Column="1" Grid.Row="1" x:Name="GuideText" Text="" Visibility="Collapsed"
                     FontFamily="Microsoft YaHei UI" FontSize="11.5"
                     Foreground="#FFBFD4F0" TextTrimming="CharacterEllipsis"
                     Margin="0,3,0,0" MaxHeight="18"/>
        </Grid>

        <!-- 展开时才有的部分：分隔线 + 日志 + 页脚 -->
        <Rectangle Grid.Row="2" x:Name="Divider" Height="1" Margin="12,0,12,0"
                   Fill="#26FFFFFF" Visibility="Collapsed"/>

        <StackPanel Grid.Row="3" x:Name="LogBlock" Visibility="Collapsed">
          <RichTextBox x:Name="LogTextBox"
                       Margin="12,5,12,0" MaxHeight="132"
                       IsReadOnly="True" IsUndoEnabled="False"
                       AcceptsReturn="False" AcceptsTab="False"
                       IsDocumentEnabled="False" Focusable="False"
                       BorderThickness="0" Background="Transparent" Padding="0"
                       VerticalScrollBarVisibility="Hidden"
                       HorizontalScrollBarVisibility="Disabled"
                       Foreground="#FFE2E8F4"
                       FontFamily="Microsoft YaHei UI" FontSize="11.5"
                       CaretBrush="Transparent"/>

          <Grid Margin="12,3,12,6">
            <TextBlock x:Name="FootText" HorizontalAlignment="Left"
                       Text="Ctrl+Alt+M 收起日志"
                       FontFamily="Microsoft YaHei UI" FontSize="9.5"
                       Foreground="#FF9AA6B8"/>
            <TextBlock x:Name="CountText" HorizontalAlignment="Right"
                       Text="0 行"
                       FontFamily="Microsoft YaHei UI" FontSize="9.5"
                       Foreground="#FF8B97A8"/>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
