<Window x:Class="TheaterAssistant.MaskWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TheaterAssistant"
        Title="剧诗助手 · 遮罩"
        Width="1280" Height="720"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        Focusable="False"
        IsTabStop="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType">

  <!--
    遮罩窗口（照抄 BetterGI 的 MaskWindow 结构，见 NOTICE.md）：
      · 整窗透明、无边框、置顶、不抢焦点、默认点击穿透 —— 盖在游戏上但不挡操作；
      · 一个绘制层（识别框 + 标签）+ 左下角日志面板（RichTextBox + OverlayLogDocument）；
      · 窗口位置/尺寸由 MaskWindowHost 按游戏客户区实时跟随，这里不写死。

    为什么不用 BGI 的 WS_CHILD 挂进游戏窗口：本项目红线是「只读、不注入」，
    独立置顶窗口同样能跟随客户区，但不会改变其他进程的窗口树。
  -->
  <Grid x:Name="Root" Background="Transparent">

    <!-- 识别框层：铺满整窗，不参与命中测试 -->
    <local:MaskDrawingLayer x:Name="DrawLayer"/>

    <!-- 左下角日志面板 -->
    <Border x:Name="LogPanel"
            HorizontalAlignment="Left" VerticalAlignment="Bottom"
            Margin="12,0,0,12"
            Width="440" MaxHeight="300"
            CornerRadius="10"
            BorderThickness="1"
            BorderBrush="#3D7EB8E8">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#CC141A22" Offset="0"/>
          <GradientStop Color="#D6080B10" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.Effect>
        <DropShadowEffect BlurRadius="18" ShadowDepth="3" Opacity="0.55" Color="#000000"/>
      </Border.Effect>

      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题行：竖条 + 名称 + 右侧状态胶囊 -->
        <Grid Grid.Row="0" Margin="10,8,10,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Border Grid.Column="0" Width="3" Height="12" CornerRadius="2"
                  Background="#FF7EB8E8" Margin="0,0,7,0" VerticalAlignment="Center"/>

          <TextBlock Grid.Column="1" Text="剧诗助手"
                     FontFamily="Microsoft YaHei UI" FontSize="12" FontWeight="SemiBold"
                     Foreground="#FFE8F0FF" VerticalAlignment="Center"/>

          <Border Grid.Column="2" x:Name="StatusChip" CornerRadius="8" Padding="7,1"
                  Background="#331E2A38" VerticalAlignment="Center">
            <TextBlock x:Name="StatusText" Text="初始化…"
                       FontFamily="Microsoft YaHei UI" FontSize="10"
                       Foreground="#FF9FC3E8"/>
          </Border>
        </Grid>

        <Rectangle Grid.Row="0" Height="1" Margin="10,26,10,0" VerticalAlignment="Bottom"
                   Fill="#26FFFFFF"/>

        <!-- 日志正文：只读、无边框、透明背景；裁剪由 OverlayLogDocument 负责 -->
        <RichTextBox Grid.Row="1" x:Name="LogTextBox"
                     Margin="10,5,10,0" MinHeight="96" MaxHeight="220"
                     IsReadOnly="True" IsUndoEnabled="False"
                     AcceptsReturn="False" AcceptsTab="False"
                     IsDocumentEnabled="False" Focusable="False"
                     BorderThickness="0" Background="Transparent" Padding="0"
                     VerticalScrollBarVisibility="Hidden"
                     HorizontalScrollBarVisibility="Disabled"
                     Foreground="#FFD6DEEE"
                     FontFamily="Microsoft YaHei UI" FontSize="11"
                     CaretBrush="Transparent"/>

        <!-- 页脚：热键提示 + 行数上限（与 BGI 一致的信息密度） -->
        <Grid Grid.Row="2" Margin="10,4,10,7">
          <TextBlock x:Name="FootText" HorizontalAlignment="Left"
                     Text="只读屏幕 · 不注入 · Ctrl+Alt+H 显隐"
                     FontFamily="Microsoft YaHei UI" FontSize="9.5"
                     Foreground="#FF7C8899"/>
          <TextBlock x:Name="CountText" HorizontalAlignment="Right"
                     Text="日志 0 行"
                     FontFamily="Microsoft YaHei UI" FontSize="9.5"
                     Foreground="#FF5C6675"/>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
