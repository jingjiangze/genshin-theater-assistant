<Window x:Class="TheaterAssistant.PetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="剧诗助手"
        Width="260" Height="360"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

  <!--
    桌宠形态（照抄开源桌宠的规范）：
      · 收起态 = 一个小形象 + 气泡，不占屏幕；
      · 点击形象 → 展开详细面板（OverlayWindow）；
      · 状态机对齐 Codex v2 pet 规范：Idle / Thinking / Waiting / Done / Sleeping。
    素材可替换：pets/<id>/spritesheet.png + pet.json；未提供时用内置的矢量形象（规避版权素材）。
  -->
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- 气泡：显示当前决策指示（自动隐藏，不挡视线） -->
    <Border x:Name="Bubble" Grid.Row="0"
            CornerRadius="14" Background="#F2FFFFFF" BorderBrush="#337EB8E8" BorderThickness="1"
            Padding="12,8" Margin="8,8,8,0" MaxHeight="190"
            Visibility="Collapsed">
      <Border.Effect>
        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35"/>
      </Border.Effect>
      <StackPanel>
        <TextBlock x:Name="BubbleHead" FontFamily="Microsoft YaHei UI" FontSize="12.5"
                   FontWeight="SemiBold" Foreground="#1C2430" TextWrapping="Wrap"/>
        <ItemsControl x:Name="BubbleLines" Margin="0,4,0,0">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}"
                         FontFamily="Microsoft YaHei UI" FontSize="11.5"
                         TextWrapping="Wrap" Margin="0,0,0,2"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- 形象区：内置矢量形象（可被 pets/ 下的 spritesheet 替换） -->
    <Canvas x:Name="PetCanvas" Grid.Row="1" VerticalAlignment="Bottom" Height="180"
            Background="Transparent" Cursor="Hand" ToolTip="点击展开详细面板 · 拖动可移动">

      <!-- 光晕 -->
      <Ellipse x:Name="Glow" Canvas.Left="70" Canvas.Top="118" Width="120" Height="26"
               Fill="#3A7EB8E8">
        <Ellipse.Effect>
          <BlurEffect Radius="18"/>
        </Ellipse.Effect>
      </Ellipse>

      <!-- 主体：一只浮空的星灵（几何形象，规避游戏素材版权） -->
      <Grid x:Name="PetBody" Canvas.Left="80" Canvas.Top="30" Width="100" Height="110">
        <Grid.RenderTransform>
          <TranslateTransform x:Name="BodyOffset" Y="0"/>
        </Grid.RenderTransform>

        <!-- 身子：圆润水滴 -->
        <Path Fill="#FFEFF6FF" Stroke="#3C7EB8E8" StrokeThickness="1.5"
              Data="M 50,6 C 74,6 92,30 92,58 C 92,86 74,104 50,104 C 26,104 8,86 8,58 C 8,30 26,6 50,6 Z"/>

        <!-- 眼睛（会眨） -->
        <Ellipse x:Name="EyeL" Canvas.Left="0" Width="11" Height="13" Fill="#FF1C2430"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,44,0,0"/>
        <Ellipse x:Name="EyeR" Width="11" Height="13" Fill="#FF1C2430"
                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="58,44,0,0"/>

        <!-- 高光 -->
        <Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="33,46,0,0" Opacity="0.9"/>
        <Ellipse Width="4" Height="4" Fill="White" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="61,46,0,0" Opacity="0.9"/>

        <!-- 腮红 -->
        <Ellipse Width="14" Height="7" Fill="#33E86A9A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,66,0,0"/>
        <Ellipse Width="14" Height="7" Fill="#33E86A9A" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="64,66,0,0"/>

        <!-- 星冠 -->
        <Path Fill="#FFFFD86A" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-6,0,0"
              Data="M 12,0 L 15.4,7.6 L 24,9 L 17.6,15 L 19.2,24 L 12,20 L 4.8,24 L 6.4,15 L 0,9 L 8.6,7.6 Z"/>
      </Grid>

      <!-- 状态角标：◆量化 ★已验证 ◇模型 ○语料 ·规则 -->
      <Border x:Name="Badge" Canvas.Left="150" Canvas.Top="34"
              CornerRadius="9" Padding="7,2" Background="#E61C2430">
        <TextBlock x:Name="BadgeText" Text="·" Foreground="#FFD6DEEE"
                   FontFamily="Microsoft YaHei UI" FontSize="11"/>
      </Border>
    </Canvas>
  </Grid>
</Window>
